// Conventions (see docs/BUILD_PLAN.md section 5):
// - money: Decimal(15,2); percentages and rates: Decimal(9,4)
// - every tenant table has orgId, createdAt, updatedAt and an index starting with orgId
// - dates are real DATE / TIMESTAMPTZ columns

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum Plan {
  STARTER
  GROWTH
  PRO
}

enum PlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  READ_ONLY
  CANCELED
}

model Org {
  id                    Int        @id @default(autoincrement())
  name                  String
  slug                  String     @unique
  state                 String     @default("TX") @db.Char(2)
  timezone              String     @default("America/Chicago")
  logoKey               String?
  primaryColor          String?
  addressLines          String[]   @default([])
  phone                 String?
  website               String?
  defaultContingencyPct Decimal    @default(0) @db.Decimal(9, 4)
  defaultFlatFee        Decimal    @default(0) @db.Decimal(15, 2)
  defaultBppFee         Decimal    @default(0) @db.Decimal(15, 2)
  invoicePrefix         String     @default("INV-")
  nextInvoiceNumber     Int        @default(1)
  invoiceDueDays        Int        @default(30)
  taxYearDefault        Int?
  stripeCustomerId      String?    @unique
  plan                  Plan       @default(STARTER)
  planStatus            PlanStatus @default(TRIALING)
  trialEndsAt           DateTime?  @db.Timestamptz(6)
  propertyLimit         Int?
  seatLimit             Int?
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  auditLogs   AuditLog[]
  invitations Invitation[]
  settings    OrgSetting[]
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  /// scrypt hash (see @app/shared/node password.ts). Never selected by tenant code.
  passwordHash    String?
  emailVerifiedAt DateTime? @db.Timestamptz(6)
  isSuperAdmin    Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  memberships     Membership[]
  auditLogs       AuditLog[]
  sessions        Session[]
  authTokens      AuthToken[]
  invitationsSent Invitation[]
}

/// Server-side session. `id` is the SHA-256 of the cookie token, so a DB leak can't be replayed.
model Session {
  id         String   @id
  userId     Int
  expiresAt  DateTime @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use email verification and password reset tokens (stored hashed).
model AuthToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(6)
  usedAt    DateTime?     @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Invitation {
  id          Int       @id @default(autoincrement())
  orgId       Int
  email       String
  role        OrgRole
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(6)
  acceptedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  invitedById Int?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, email])
}

/// Non-secret per-org settings. Secrets live in env/KMS, never here.
model OrgSetting {
  id        Int      @id @default(autoincrement())
  orgId     Int
  key       String
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

model Membership {
  id        Int              @id @default(autoincrement())
  orgId     Int
  userId    Int
  role      OrgRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// Append-only. Rows are never updated or deleted by the application.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  orgId       Int
  actorUserId Int?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  org   Org   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
}
