// Conventions (see docs/BUILD_PLAN.md section 5):
// - money: Decimal(15,2); percentages and rates: Decimal(9,4)
// - every tenant table has orgId, createdAt, updatedAt and an index starting with orgId
// - dates are real DATE / TIMESTAMPTZ columns

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SavingsBasis {
  APPRAISED
  MARKET
}

enum ContactKind {
  PROSPECT
  CLIENT
}

enum ProspectStatus {
  NEW
  CONTACTED
  DOCS_SENT
  SIGNED
  LOST
}

enum EntityType {
  INDIVIDUAL
  COMPANY
}

enum ContactSource {
  WEB_FORM
  MANUAL
  IMPORT
  REFERRAL
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  BPP
  LAND
  OTHER
}

/// BUILD_PLAN 5.4. One per property-year.
enum ProtestStage {
  NOT_STARTED
  AOA_SIGNED
  NOTICE_RECEIVED
  PROTEST_FILED
  HEARING_SCHEDULED
  SETTLED
  BOARD_ORDER
  NO_CHANGE
  WITHDRAWN
  INVOICED
  PAID
}

enum ResultType {
  SETTLEMENT
  BOARD_ORDER
  NO_CHANGE
  WITHDRAWN
}

/// Spec savings-calculator.md: how a taxing unit is treated (school units carry the over-65 ceiling).
enum TaxUnitKind {
  SCHOOL
  COUNTY
  CITY
  OTHER
}

/// BUILD_PLAN 5.8. HISTORICAL_INVOICES arrives with invoices (M4).
enum ImportKind {
  CONTACTS_PROPERTIES
  TAX_YEAR_VALUES
  HISTORICAL_INVOICES
}

enum ImportStatus {
  UPLOADED
  PREVIEWED
  RUNNING
  DONE
  FAILED
}

/// What a row did (or would do, in a dry run).
enum ImportAction {
  CREATE
  UPDATE
  UNCHANGED
  ERROR
}

enum ImportPhase {
  PREVIEW
  APPLY
}

enum InvoiceGrouping {
  /// One invoice per client per tax year, a line per property (BUILD_PLAN 5.6 default).
  CLIENT_YEAR
  /// One invoice per property per tax year.
  PROPERTY_YEAR
}

/// PARTIALLY_PAID and PAID are derived from allocations; past due is never stored.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  WRITTEN_OFF
}

enum InvoiceTemplate {
  STANDARD
  ARBITRATION
  HOMESTEAD
  ZERO_SAVINGS
}

enum InvoiceLineKind {
  CONTINGENCY
  FLAT
  BPP
  ADJUSTMENT
}

enum PaymentMethod {
  ZELLE
  CHECK
  ACH
  CASH
  CARD
  OTHER
}

enum Plan {
  STARTER
  GROWTH
  PRO
}

enum PlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  READ_ONLY
  CANCELED
}

model Org {
  id                     Int             @id @default(autoincrement())
  name                   String
  slug                   String          @unique
  state                  String          @default("TX") @db.Char(2)
  timezone               String          @default("America/Chicago")
  logoKey                String?
  primaryColor           String?
  addressLines           String[]        @default([])
  phone                  String?
  website                String?
  defaultContingencyPct  Decimal         @default(0) @db.Decimal(9, 4)
  defaultFlatFee         Decimal         @default(0) @db.Decimal(15, 2)
  defaultBppFee          Decimal         @default(0) @db.Decimal(15, 2)
  invoicePrefix          String          @default("INV-")
  nextInvoiceNumber      Int             @default(1)
  invoiceDueDays         Int             @default(30)
  /// The current billing (protest) year. Null means the calendar year.
  taxYearDefault         Int?
  nextClientNumber       Int             @default(1001)
  /// BUILD_PLAN 7 [ASK]: which value savings are measured on.
  savingsBasis           SavingsBasis    @default(APPRAISED)
  /// The flat fee is only charged on the current billing year (reference-app rule).
  flatFeeCurrentYearOnly Boolean         @default(true)
  invoiceGrouping        InvoiceGrouping @default(CLIENT_YEAR)
  /// Printed on invoices: Zelle, check address, ACH details.
  paymentInstructions    String?
  stripeCustomerId       String?         @unique
  plan                   Plan            @default(STARTER)
  planStatus             PlanStatus      @default(TRIALING)
  trialEndsAt            DateTime?       @db.Timestamptz(6)
  propertyLimit          Int?
  seatLimit              Int?
  createdAt              DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(6)

  memberships  Membership[]
  auditLogs    AuditLog[]
  invitations  Invitation[]
  settings     OrgSetting[]
  contacts     Contact[]
  properties   Property[]
  taxYears     TaxYearRecord[]
  stageEvents  ProtestStageEvent[]
  imports      ImportJob[]
  importRows   ImportRow[]
  invoices     Invoice[]
  invoiceLines InvoiceLine[]
  payments     Payment[]
  allocations  PaymentAllocation[]
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  /// scrypt hash (see @app/shared/node password.ts). Never selected by tenant code.
  passwordHash    String?
  emailVerifiedAt DateTime? @db.Timestamptz(6)
  isSuperAdmin    Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  memberships     Membership[]
  auditLogs       AuditLog[]
  sessions        Session[]
  authTokens      AuthToken[]
  invitationsSent Invitation[]
  consultantFor   Property[]
  stageEvents     ProtestStageEvent[]
  imports         ImportJob[]
  invoicesCreated Invoice[]
  paymentsCreated Payment[]
}

/// Server-side session. `id` is the SHA-256 of the cookie token, so a DB leak can't be replayed.
model Session {
  id         String   @id
  userId     Int
  expiresAt  DateTime @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use email verification and password reset tokens (stored hashed).
model AuthToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(6)
  usedAt    DateTime?     @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Invitation {
  id          Int       @id @default(autoincrement())
  orgId       Int
  email       String
  role        OrgRole
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(6)
  acceptedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  invitedById Int?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, email])
}

/// Non-secret per-org settings. Secrets live in env/KMS, never here.
model OrgSetting {
  id        Int      @id @default(autoincrement())
  orgId     Int
  key       String
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

model Membership {
  id        Int              @id @default(autoincrement())
  orgId     Int
  userId    Int
  role      OrgRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// Append-only. Rows are never updated or deleted by the application.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  orgId       Int
  actorUserId Int?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  org   Org   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
}

/// Platform reference data: all 254 Texas counties and their appraisal districts. Not tenant data.
model County {
  id         Int     @id @default(autoincrement())
  state      String  @db.Char(2)
  name       String
  cadName    String
  cadWebsite String?

  properties Property[]
  cadParcels CadParcel[]
  cadUnits   CadTaxUnit[]
  cadLoads   CadLoad[]

  @@unique([state, name])
}

/// One account on a CAD's certified roll (public reference data, not tenant data). Loaded by
/// `pnpm db:backfill cad`; the savings calculator compares a parcel with its neighbors.
model CadParcel {
  id               Int      @id @default(autoincrement())
  countyId         Int
  taxYear          Int
  /// Normalized like Property.accountNumber.
  accountNumber    String
  /// State property tax code, e.g. A1 = single-family residence.
  stateClass       String
  neighborhoodCode String
  ownerName        String?
  situsLine        String?
  situsZip         String?
  landValue        Decimal  @db.Decimal(15, 2)
  improvementValue Decimal  @db.Decimal(15, 2)
  marketValue      Decimal  @db.Decimal(15, 2)
  /// After the homestead or circuit-breaker cap.
  appraisedValue   Decimal  @db.Decimal(15, 2)
  /// Living area for homes; building area for commercial property.
  livingAreaSqft   Int?
  yearBuilt        Int?
  qualityCode      String?
  /// Building type for commercial property (e.g. "Office Bldgs. Low-Rise"); comps must match.
  propertyUse      String?
  /// The CAD's wider market area, for commercial comparables beyond the neighborhood.
  marketArea       String?
  /// Improvement value per sq ft ÷ the median of its neighborhood (same class, and same building
  /// type for commercial). 1.25 = appraised 25% above comparable neighbors. Set by the loader.
  equityIndex      Decimal? @db.Decimal(9, 4)
  homestead        Boolean  @default(false)
  /// Over-65 or disabled homestead: school taxes are frozen (§11.26).
  taxCeiling       Boolean  @default(false)
  /// [{ code, taxableValue, exemptPct }]: the account's taxing units.
  units            Json     @default("[]")

  county County @relation(fields: [countyId], references: [id])

  @@unique([countyId, taxYear, accountNumber])
  @@index([countyId, taxYear, neighborhoodCode, stateClass, livingAreaSqft])
  @@index([countyId, taxYear, marketArea, stateClass, propertyUse])
  @@index([countyId, taxYear, equityIndex])
  @@index([countyId, taxYear, marketValue])
  @@index([situsLine(ops: raw("gin_trgm_ops"))], type: Gin, map: "CadParcel_situsLine_trgm")
  @@index([ownerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CadParcel_ownerName_trgm")
}

/// A taxing unit (school district, county, city, MUD …) and its rate for one year.
model CadTaxUnit {
  id       Int         @id @default(autoincrement())
  countyId Int
  taxYear  Int
  code     String
  name     String
  kind     TaxUnitKind @default(OTHER)
  /// Percent: 1.0 means 1%. Null until the unit adopts its rate.
  ratePct  Decimal?    @db.Decimal(9, 6)

  county County @relation(fields: [countyId], references: [id])

  @@unique([countyId, taxYear, code])
}

/// Provenance: which roll files were loaded for a county-year, and when.
model CadLoad {
  id          Int      @id @default(autoincrement())
  countyId    Int
  taxYear     Int
  source      String
  files       Json
  parcelCount Int
  /// Known gaps in this county's data, shown as warnings on its estimates.
  notes       String[] @default([])
  /// When this county-year's data last changed (a load, or a re-index): caches key on it.
  loadedAt    DateTime @default(now()) @db.Timestamptz(6)

  county County @relation(fields: [countyId], references: [id])

  @@unique([countyId, taxYear])
}

/// Prospects and clients share one table (BUILD_PLAN 5.2). Converting a prospect sets kind=CLIENT,
/// assigns a clientNumber and stamps convertedAt, which is never overwritten afterwards.
model Contact {
  id             Int             @id @default(autoincrement())
  orgId          Int
  kind           ContactKind
  status         ProspectStatus?
  clientNumber   String?
  displayName    String
  entityType     EntityType      @default(INDIVIDUAL)
  email          String?
  billingEmail   String?
  phone          String?
  /// { line1, line2, city, state, zip }
  mailingAddress Json?
  billingAddress Json?
  nameOnCad      String?
  contingencyPct Decimal?        @db.Decimal(9, 4)
  flatFee        Decimal?        @db.Decimal(15, 2)
  bppFee         Decimal?        @db.Decimal(15, 2)
  source         ContactSource   @default(MANUAL)
  notes          String?
  convertedAt    DateTime?       @db.Timestamptz(6)
  archivedAt     DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  properties Property[]
  invoices   Invoice[]
  payments   Payment[]

  /// Target of same-org composite foreign keys.
  @@unique([orgId, id])
  @@unique([orgId, clientNumber])
  @@index([orgId, kind, archivedAt])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  // Trigram indexes for search (pg_trgm).
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_displayName_trgm")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm")
  @@index([clientNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_clientNumber_trgm")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_phone_trgm")
}

model Property {
  id                  Int          @id @default(autoincrement())
  orgId               Int
  contactId           Int
  /// CAD account number, normalized (no spaces). Unique per org and county, not globally.
  accountNumber       String
  countyId            Int
  /// { line1, city, state, zip }
  situsAddress        Json?
  /// One-line situs address, for search and lists.
  situsLine           String?
  propertyType        PropertyType @default(RESIDENTIAL)
  consultantUserId    Int?
  contingencyPct      Decimal?     @db.Decimal(9, 4)
  flatFee             Decimal?     @db.Decimal(15, 2)
  bppFee              Decimal?     @db.Decimal(15, 2)
  notes               String?
  archivedAt          DateTime?    @db.Timestamptz(6)
  /// True when archived because its contact was archived; restoring the contact restores only these.
  archivedWithContact Boolean      @default(false)
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  org          Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK: a property can only belong to a contact in the same org.
  contact      Contact         @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Restrict)
  county       County          @relation(fields: [countyId], references: [id])
  consultant   User?           @relation(fields: [consultantUserId], references: [id], onDelete: SetNull)
  taxYears     TaxYearRecord[]
  invoiceLines InvoiceLine[]

  @@unique([orgId, id])
  @@unique([orgId, countyId, accountNumber])
  @@index([orgId, contactId])
  @@index([orgId, consultantUserId])
  @@index([orgId, archivedAt])
  @@index([accountNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Property_accountNumber_trgm")
  @@index([situsLine(ops: raw("gin_trgm_ops"))], type: Gin, map: "Property_situsLine_trgm")
}

/// Values and protest status for one property in one tax year. Fees are never stored here;
/// they come from the fee engine and are snapshotted onto invoices (M4).
model TaxYearRecord {
  id                     Int          @id @default(autoincrement())
  orgId                  Int
  propertyId             Int
  taxYear                Int
  noticeLand             Decimal?     @db.Decimal(15, 2)
  noticeImprovement      Decimal?     @db.Decimal(15, 2)
  noticeMarket           Decimal?     @db.Decimal(15, 2)
  noticeAppraised        Decimal?     @db.Decimal(15, 2)
  finalLand              Decimal?     @db.Decimal(15, 2)
  finalImprovement       Decimal?     @db.Decimal(15, 2)
  finalMarket            Decimal?     @db.Decimal(15, 2)
  finalAppraised         Decimal?     @db.Decimal(15, 2)
  /// Combined tax rate as a percentage, e.g. 2.1500 means 2.15%.
  taxRatePct             Decimal?     @db.Decimal(9, 4)
  bppRenderedAt          DateTime?    @db.Date
  bppFee                 Decimal?     @db.Decimal(15, 2)
  underLitigation        Boolean      @default(false)
  underArbitration       Boolean      @default(false)
  homestead              Boolean      @default(false)
  protestStage           ProtestStage @default(NOT_STARTED)
  noticeReceivedAt       DateTime?    @db.Date
  protestFiledAt         DateTime?    @db.Date
  resultType             ResultType?
  resultAt               DateTime?    @db.Date
  /// Nullable; 0 is a real 0%.
  contingencyPctOverride Decimal?     @db.Decimal(9, 4)
  notes                  String?
  createdAt              DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(6)

  org          Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property     Property            @relation(fields: [orgId, propertyId], references: [orgId, id], onDelete: Cascade)
  stageEvents  ProtestStageEvent[]
  invoiceLines InvoiceLine[]

  @@unique([orgId, id])
  @@unique([propertyId, taxYear])
  @@index([orgId, taxYear, protestStage])
}

/// Append-only stage history for a TaxYearRecord.
model ProtestStageEvent {
  id              Int           @id @default(autoincrement())
  orgId           Int
  taxYearRecordId Int
  fromStage       ProtestStage?
  toStage         ProtestStage
  note            String?
  actorUserId     Int?
  at              DateTime      @default(now()) @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  org           Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taxYearRecord TaxYearRecord @relation(fields: [orgId, taxYearRecordId], references: [orgId, id], onDelete: Cascade)
  actor         User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, taxYearRecordId, at])
}

/// A CSV import (BUILD_PLAN 8.9): upload → mapping → dry run → confirm → background job.
model ImportJob {
  id            Int          @id @default(autoincrement())
  orgId         Int
  kind          ImportKind
  status        ImportStatus @default(UPLOADED)
  /// Storage key of the uploaded file (org/{orgId}/imports/…).
  fileKey       String
  fileName      String
  rowCount      Int
  /// The file's header row, as written.
  headers       String[]
  /// { [header]: field key } — which column feeds which field.
  columnMapping Json         @default("{}")
  /// Counts per action, from the latest dry run or run: { CREATE, UPDATE, UNCHANGED, ERROR }.
  summary       Json?
  /// Why a run failed as a whole (row-level problems are ImportRow errors).
  error         String?
  createdById   Int?
  previewedAt   DateTime?    @db.Timestamptz(6)
  startedAt     DateTime?    @db.Timestamptz(6)
  finishedAt    DateTime?    @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)

  org       Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rows      ImportRow[]

  @@unique([orgId, id])
  @@index([orgId, createdAt])
}

/// One row's outcome. A dry run's rows are replaced by the run's.
model ImportRow {
  id          Int          @id @default(autoincrement())
  orgId       Int
  importJobId Int
  phase       ImportPhase
  /// 1-based data row number (the header row is not counted), as people see it in a spreadsheet + 1.
  rowNumber   Int
  action      ImportAction
  /// Short description: "Jane Smith (1042) · Harris 0660640130020".
  label       String?
  /// Fields that changed (UPDATE) — names, not values.
  changes     String[]     @default([])
  messages    String[]     @default([])
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  importJob ImportJob @relation(fields: [orgId, importJobId], references: [orgId, id], onDelete: Cascade)

  @@index([orgId, importJobId, phase, rowNumber])
  @@index([orgId, importJobId, phase, action])
}

/// BUILD_PLAN 5.6. Totals are kept in step with lines and allocations by the billing service.
model Invoice {
  id             Int             @id @default(autoincrement())
  orgId          Int
  contactId      Int
  /// Prefix + sequence, assigned at issue; null while a draft.
  number         String?
  taxYear        Int
  status         InvoiceStatus   @default(DRAFT)
  issueDate      DateTime?       @db.Date
  dueDate        DateTime?       @db.Date
  template       InvoiceTemplate @default(STANDARD)
  subtotal       Decimal         @default(0) @db.Decimal(15, 2)
  total          Decimal         @default(0) @db.Decimal(15, 2)
  amountPaid     Decimal         @default(0) @db.Decimal(15, 2)
  balance        Decimal         @default(0) @db.Decimal(15, 2)
  currency       String          @default("USD") @db.Char(3)
  pdfKey         String?
  sentAt         DateTime?       @db.Timestamptz(6)
  voidedAt       DateTime?       @db.Timestamptz(6)
  voidReason     String?
  writtenOffAt   DateTime?       @db.Timestamptz(6)
  writeOffReason String?
  notes          String?
  /// Imported from the firm's old system (CSV): no fee snapshot behind it.
  historical     Boolean         @default(false)
  createdById    Int?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  org         Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact     Contact             @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Restrict)
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([orgId, id])
  @@unique([orgId, number])
  @@index([orgId, status, dueDate])
  @@index([orgId, contactId])
  @@index([orgId, taxYear])
  @@index([orgId, issueDate])
}

model InvoiceLine {
  id              Int             @id @default(autoincrement())
  orgId           Int
  invoiceId       Int
  propertyId      Int?
  taxYearRecordId Int?
  kind            InvoiceLineKind
  description     String
  /// Fee-engine inputs and outputs at issue time (BUILD_PLAN 7 "Snapshotting"). Frozen once issued.
  snapshot        Json?
  amount          Decimal         @db.Decimal(15, 2)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  org           Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice       Invoice        @relation(fields: [orgId, invoiceId], references: [orgId, id], onDelete: Cascade)
  property      Property?      @relation(fields: [orgId, propertyId], references: [orgId, id], onDelete: Restrict)
  taxYearRecord TaxYearRecord? @relation(fields: [orgId, taxYearRecordId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, invoiceId])
  @@index([orgId, taxYearRecordId])
}

/// A payment from a client. What isn't allocated to invoices is the client's credit.
model Payment {
  id          Int           @id @default(autoincrement())
  orgId       Int
  contactId   Int
  receivedAt  DateTime      @db.Date
  amount      Decimal       @db.Decimal(15, 2)
  method      PaymentMethod
  reference   String?
  notes       String?
  createdById Int?
  /// Deleted payments keep their row for the audit trail; their allocations are removed.
  deletedAt   DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  org         Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact     Contact             @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Restrict)
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@unique([orgId, id])
  @@index([orgId, contactId])
  @@index([orgId, receivedAt])
}

model PaymentAllocation {
  id        Int      @id @default(autoincrement())
  orgId     Int
  paymentId Int
  invoiceId Int
  amount    Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [orgId, paymentId], references: [orgId, id], onDelete: Cascade)
  invoice Invoice @relation(fields: [orgId, invoiceId], references: [orgId, id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([orgId, invoiceId])
}
