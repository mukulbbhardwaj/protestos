# Copy to .env (`pnpm dev` does this for you on first run). Never commit .env.
# Values below are local-development placeholders only.

NODE_ENV=development

# Postgres (docker-compose.yml exposes it on 54329 to avoid clashing with a local install)
DATABASE_URL=postgresql://app:app@localhost:54329/app
# Separate database for integration tests; tests may truncate it.
TEST_DATABASE_URL=postgresql://app:app@localhost:54329/app_test

# API
API_HOST=0.0.0.0
API_PORT=3001
APP_VERSION=dev

# Logging: info in prod; LOG_PRETTY=true for human-readable local logs
LOG_LEVEL=info
LOG_PRETTY=true

# Sentry (optional; leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_SENTRY_DSN=
