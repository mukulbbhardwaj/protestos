{
  "name": "app-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "node scripts/dev-setup.mjs && turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @app/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @app/db migrate:dev",
    "db:generate": "pnpm --filter @app/db generate",
    "secrets:scan": "gitleaks dir . --config .gitleaks.toml --redact",
    "db:seed": "pnpm --filter @app/db seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lefthook": "2.2.3",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
