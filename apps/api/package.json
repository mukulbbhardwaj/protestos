{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@app/imports": "workspace:*",
    "@app/mailer": "workspace:*",
    "@app/pdf": "workspace:*",
    "@app/providers": "workspace:*",
    "@app/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.3.0",
    "@sentry/node": "11.17.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pg-boss": "12.39.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.6",
    "pdf-lib": "1.17.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
